            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "period": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "groups"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "version",
      "profile"
    ],
    "additionalProperties": false
  }
