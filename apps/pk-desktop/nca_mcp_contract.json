  "covariate_specification": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Pre-NCA covariate input specification v1",
    "type": "object",
    "properties": {
      "version": {
        "const": 1
      },
      "dm": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "columns": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          }
        },
        "required": [
          "keys",
          "columns"
        ],
        "additionalProperties": false
      },
      "vs": {
        "type": "object",
        "properties": {
          "keys": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "scope": {
            "enum": [
              "subject",
              "keys"
            ]
          },
          "test_column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value_column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "unit_column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "datetime_column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "visit_column": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "selection": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "all_unique"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "filter"
                  },
                  "column": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100
                  },
                  "values": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "uniqueItems": true,
                    "items": {
                      "type": [
                        "string",
                        "number"
                      ]
                    }
                  }
                },
                "required": [
                  "mode",
                  "column",
                  "values"
                ],
                "additionalProperties": false
              }
            ]
          },
          "measurements": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100,
                  "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
                },
                "test": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "role": {
                  "enum": [
                    "weight",
                    "height",
                    "bsa",
                    "carry"
                  ]
                }
              },
              "required": [
                "name",
                "test",
                "role"
              ],
              "additionalProperties": false
            }
          },
          "baseline": {
            "type": "object",
            "properties": {
              "mode": {
                "enum": [
                  "period",
                  "subject_confirmed"
                ]
              },
              "confirmed": {
                "const": true
              }
            },
            "required": [
              "mode",
              "confirmed"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "keys",
          "scope",
          "test_column",
          "value_column",
          "unit_column",
          "selection",
          "measurements",
          "baseline"
        ],
        "additionalProperties": false
      },
      "profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "groups": {
            "type": "array",
            "uniqueItems": true,
